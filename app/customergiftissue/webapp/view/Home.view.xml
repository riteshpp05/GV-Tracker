<mvc:View controllerName="com.mall.customergiftissue.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns:unified="sap.ui.unified"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="page" title="GV Tracker - Transaction Dashboard">
        <headerContent>
            <Button text="Register Customer" press=".onNavToAddCustomer" />
            <Button text="Display Transaction" press=".onNavToDisplay" />
        </headerContent>
        <content>
            <f:SimpleForm editable="true" layout="ResponsiveGridLayout" title="Transaction Details" columnsL="1" columnsM="1">
                <f:content>
                    <Label text="Transaction Type" />
                    <RadioButtonGroup id="transactionType" select=".onTypeSelect" columns="4">
                        <RadioButton text="Issue (CI)" customData:key="CI" xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1" />
                        <RadioButton text="Return (RT)" customData:key="RT" xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"/>
                        <RadioButton text="Replace (RP)" customData:key="RP" xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"/>
                    </RadioButtonGroup>

                    <Label text="Customer ID" />
                    <Input value="{uiState>/customer_ID}" placeholder="Enter Customer UUID" />

                    <Label text="Campaign Name" visible="{= ${uiState>/gvr_type_code} === 'CI' }" />
                    <Input value="{uiState>/campaign_name}" placeholder="Enter Campaign Name" visible="{= ${uiState>/gvr_type_code} === 'CI' }" />

                    <Label text="Employee Code" />
                    <Input value="{uiState>/employee_code}" placeholder="e.g. EMP9001" />

                </f:content>
            </f:SimpleForm>

            <Panel headerText="Gift Vouchers to Assign" visible="{= ${uiState>/gvr_type_code} !== 'RT' }">
                <Table items="{uiState>/assignGiftVouchers}">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Vouchers" />
                            <ToolbarSpacer />
                            <Button icon="sap-icon://add" press=".onAddAssignVoucher" />
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column><Text text="Voucher ID" /></Column>
                        <Column><Text text="Quantity" /></Column>
                        <Column><Text text="Total Amount" /></Column>
                        <Column width="3rem" hAlign="Center"><Text text="" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Input value="{uiState>giftVoucher_ID}" />
                                <Input value="{uiState>issue_quantity}" type="Number" />
                                <Input value="{uiState>total_amount}" />
                                <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteAssignVoucher" tooltip="Delete row" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>

            <Panel headerText="Gift Vouchers to Return" visible="{= ${uiState>/gvr_type_code} === 'RT' || ${uiState>/gvr_type_code} === 'RP' }">
                <Table items="{uiState>/returnGiftVouchers}">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Vouchers" />
                            <ToolbarSpacer />
                            <Button icon="sap-icon://add" press=".onAddReturnVoucher" />
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column><Text text="Original Assignment ID" /></Column>
                        <Column><Text text="Quantity" /></Column>
                        <Column width="3rem" hAlign="Center"><Text text="" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Input value="{uiState>RT_Ass_GiftVoucher_ID}" />
                                <Input value="{uiState>issue_quantity}" type="Number" />
                                <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteReturnVoucher" tooltip="Delete row" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
            <Panel headerText="Customer Shopping Bills" visible="{= ${uiState>/gvr_type_code} === 'CI' }">
                <Table items="{uiState>/bills}">
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Bills" />
                            <ToolbarSpacer />
                            <Button icon="sap-icon://add" press=".onAddBill" />
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column><Text text="Bill Number" /></Column>
                        <Column><Text text="Bill Amount" /></Column>
                        <Column><Text text="Attachment" /></Column>
                        <Column width="3rem" hAlign="Center"><Text text="" /></Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <Input value="{uiState>b_no}" />
                                <Input value="{uiState>b_amount}" type="Number" />
                                <unified:FileUploader
                                    fileType="pdf,jpg,jpeg,png"
                                    maximumFileSize="5"
                                    change=".onFileChange"
                                    buttonText="Choose File"
                                    style="Emphasized" />
                                <Button icon="sap-icon://delete" type="Transparent" press=".onDeleteBill" tooltip="Delete row" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </Panel>
        </content>
        <footer>
            <Toolbar>
                <ToolbarSpacer/>
                <Button text="Submit Transaction" type="Emphasized" press=".onSubmit" />
            </Toolbar>
        </footer>
    </Page>
</mvc:View>