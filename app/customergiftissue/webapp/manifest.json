{
  "_version": "1.89.0",
  "sap.app": {
    "id": "com.mall.customergiftissue",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": ["en", ""],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "43678dd5-fb5e-4055-a7d8-aea6fa80f9ad"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/gv-tracker/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.unified": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.mall.customergiftissue.i18n.i18n",
          "supportedLocales": ["en", ""],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.mall.customergiftissue.view",
        "async": true,
        "viewPath": "com.mall.customergiftissue.view"
      },
      "routes": [
        {
          "name": "RouteHome",
          "pattern": ":?query:",
          "target": [
            "TargetHome"
          ]
        },
        {
          "name": "RouteDisplay",
          "pattern": "display/{gv_no}",
          "target": [
            "TargetDisplay"
          ]
        },
        {
          "name": "RouteAddCustomer",
          "pattern": "addCustomer",
          "target": [
            "TargetAddCustomer"
          ]
        }
      ],
      "targets": {
        "TargetHome": {
          "id": "Home",
          "name": "Home"
        },
        "TargetDisplay": {
          "id": "Display",
          "name": "Display"
        },
        "TargetAddCustomer": {
          "id": "AddCustomer",
          "name": "AddCustomer"
        }
      }
    },
    "rootView": {
      "viewName": "com.mall.customergiftissue.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
